 @dataclass
 class _Accum:
-    """Running count / sum / sum-of-squares for online mean & variance."""
+    """Running count / sum / sum-of-squares for online mean & variance.
+
+    Two views live in one accumulator. ``n`` / ``sum`` / ``sumsq`` are the
+    TOTALS: every observation this arm ever recorded, including requests
+    carrying no conversation provenance -- a ledger written before
+    conversation labels existed, or a client path that has not adopted them.
+    Totals keep feeding the estimated (synthetic-control) tier, which is
+    reported as an estimate and never claimed to be causal.
+
+    :attr:`qualified` is the subset of those observations that arrived WITH a
+    conversation label, and it is the only view
+    :meth:`SavingsLedger.estimate_from_holdout` reads. Keeping it a separate
+    accumulator rather than a flag on the totals is what makes provenance
+    structural: unattributed traffic has nowhere to land in the measured path,
+    so it cannot ride into an estimate on the back of a stratum that later
+    qualifies, and the cluster count is always counted over exactly the
+    observations whose mean and variance it is vouching for.
+    """
 
     n: int = 0
     sum: float = 0.0
     sumsq: float = 0.0
     #: Distinct conversation ids behind ``n``, capped at ``_CLUSTER_CAP``.
+    #: Only ever populated on a :attr:`qualified` accumulator.
     clusters: set[str] = field(default_factory=set)
+    #: Provenance-qualified subset, created on the first labelled observation.
+    #: ``None`` means nothing here is attributable to a conversation, which is
+    #: the permanent state of every accumulator loaded from a pre-upgrade
+    #: ledger: those sums cannot be split after the fact.
+    qualified: _Accum | None = None
 
-    def add(self, x: float, cluster: str | None = None) -> None:
+    def _observe(self, x: float) -> None:
         self.n += 1
         self.sum += x
         self.sumsq += x * x
-        if cluster is not None and len(self.clusters) < _CLUSTER_CAP:
-            self.clusters.add(cluster)
+
+    def add(self, x: float, cluster: str | None = None) -> None:
+        self._observe(x)
+        if cluster is None:
+            # Totals only. An observation we cannot attribute to a
+            # conversation is not evidence about a conversation, so it never
+            # reaches the measured estimate -- not even in a stratum whose
+            # labelled traffic has already cleared the gate.
+            return
+        q = self.qualified
+        if q is None:
+            q = self.qualified = _Accum()
+        q._observe(x)
+        if len(q.clusters) < _CLUSTER_CAP:
+            q.clusters.add(cluster)
 
     @property
     def n_clusters(self) -> int:
         """Distinct conversations observed, saturating at ``_CLUSTER_CAP``.
 
-        0 for an accumulator written before conversations were tracked, which
-        is why that data cannot clear :data:`MEASURED_MIN_CLUSTERS`: an
-        unverifiable arm is treated as an unqualified one.
+        0 on a totals accumulator, whose observations are not attributed;
+        :meth:`SavingsLedger.estimate_from_holdout` reads it on the
+        :attr:`qualified` view, where every observation carried a label.
         """
         return len(self.clusters)
 
@@ -134,18 +170,28 @@ class _Accum:
 
         n / sum / sumsq are additive, so merging is element-wise addition and
         is exactly equivalent to having ``add``-ed both observation streams.
+        The qualified subset merges the same way and only into itself, so a
+        merge cannot launder unattributed observations into the measured view.
         """
         self.n += other.n
         self.sum += other.sum
         self.sumsq += other.sumsq
-        self.clusters |= set(list(other.clusters)[: _CLUSTER_CAP - len(self.clusters)])
+        room = max(0, _CLUSTER_CAP - len(self.clusters))
+        self.clusters |= set(sorted(other.clusters)[:room])
+        if other.qualified is not None:
+            if self.qualified is None:
+                self.qualified = _Accum()
+            self.qualified.merge(other.qualified)
 
     def to_dict(self) -> dict[str, Any]:
         d: dict[str, Any] = {"n": self.n, "sum": self.sum, "sumsq": self.sumsq}
-        # Omitted when empty so a baseline model (which has no conversations to
-        # track) serializes exactly as it did before.
+        # Both keys are omitted when there is nothing to say, so a baseline
+        # model (no conversations, no qualified subset) serializes exactly as
+        # it did before.
         if self.clusters:
             d["clusters"] = sorted(self.clusters)
+        if self.qualified is not None:
+            d["qualified"] = self.qualified.to_dict()
         return d
 
     @classmethod
@@ -155,6 +201,12 @@ class _Accum:
         a.sum = float(d.get("sum", 0.0))
         a.sumsq = float(d.get("sumsq", 0.0))
         a.clusters = {str(c) for c in (d.get("clusters") or ())}
+        # Absent on every ledger written before provenance was recorded. That
+        # arm keeps its totals for the estimated tier and stays out of the
+        # measured one until it re-accumulates labelled traffic of its own.
+        q = d.get("qualified")
+        if isinstance(q, dict):
+            a.qualified = cls.from_dict(q)
         return a
 
 
@@ -347,11 +399,21 @@ class SavingsLedger:
     def estimate_from_holdout(self) -> SavingsEstimate | None:
         """A/B measurement: per-stratum control mean minus treatment mean.
 
-        Only strata with data in BOTH arms contribute, and only once both
-        arms hold :data:`MEASURED_MIN_CLUSTERS` distinct conversations.
-        Returns ``None`` if no such stratum exists (no holdout traffic yet, or
-        none of it spread across enough conversations). Weighted by treatment
-        volume; this is the unbiased causal number.
+        Reads ONLY the provenance-qualified subset of each arm
+        (:attr:`_Accum.qualified`) -- the observations that arrived carrying a
+        conversation label. Totals are deliberately not consulted here: an arm
+        can hold requests recorded before conversations were tracked, and
+        folding those into a stratum that five fresh conversations have just
+        qualified reports their contamination as a measurement (a legacy
+        stratum of 2,500 unattributed requests per arm flipped this estimate
+        from ``None`` to a "measured" -99.8% that way, while the labelled
+        conversations underneath showed no difference at all).
+
+        A stratum contributes once BOTH qualified arms hold
+        :data:`MEASURED_MIN_CLUSTERS` distinct conversations. Returns ``None``
+        if no stratum qualifies (no holdout traffic yet, or none of it spread
+        across enough conversations). Weighted by treatment volume; this is
+        the unbiased causal number.
 
         The cluster gate is not a sample-size nicety. Assignment is
         conversation-stable, so the requests inside one conversation are one
@@ -366,9 +428,12 @@ class SavingsLedger:
         var = 0.0
         n_requests = 0
         contributing = 0
-        for key, t in self.treatment.items():
-            c = self.control.get(key)
-            if c is None or c.n == 0 or t.n == 0:
+        for key, t_all in self.treatment.items():
+            c_all = self.control.get(key)
+            if c_all is None:
+                continue
+            t, c = t_all.qualified, c_all.qualified
+            if t is None or c is None or c.n == 0 or t.n == 0:
                 continue
             if c.n_clusters < MEASURED_MIN_CLUSTERS or t.n_clusters < MEASURED_MIN_CLUSTERS:
                 continue
@@ -554,8 +619,10 @@ class SavingsRecorder:
         The conversation label may sit either side of the stratum label, so the
         labels are scanned once for both before recording. A request that
         carries no conversation label (an older client, or a path that has not
-        adopted it) still records its output tokens; it just does not advance
-        the stratum's cluster count.
+        adopted it) still records its output tokens into the arm's totals, so
+        the estimated tier keeps counting it -- but with no conversation to
+        attribute it to it stays out of the provenance-qualified subset, and
+        so out of the measured estimate entirely.
         """
         arm_key: tuple[str, str] | None = None
         conversation: str | None = None
