+
+class TestMeasuredProvenanceQuarantine:
+    """Only observations we can attribute to a conversation may be measured.
+
+    The cluster gate alone is not enough. An arm's totals can hold requests
+    recorded before conversation labels existed, and the gate is a per-stratum
+    admission test: once five fresh conversations clear it, every legacy
+    request already sitting in that stratum's mean and variance rides in with
+    them. That is not a thin-sample problem, it is a provenance problem -- so
+    the qualified observations are accumulated separately and the measured
+    estimate reads nothing else.
+    """
+
+    #: One stratum's arms as a pre-upgrade ledger wrote them: request totals,
+    #: no conversation anywhere. Treatment output is double control's, so any
+    #: leak into the measured view is loud.
+    @staticmethod
+    def _legacy_dict(n=2_500, treat_tokens=1_000.0, control_tokens=500.0):
+        return {
+            "baseline": {"strata": {}},
+            "treatment": {"s": {"n": n, "sum": n * treat_tokens, "sumsq": n * treat_tokens**2}},
+            "control": {"s": {"n": n, "sum": n * control_tokens, "sumsq": n * control_tokens**2}},
+        }
+
+    @staticmethod
+    def _add_matched_conversations(ledger, count=MEASURED_MIN_CLUSTERS, tokens=500):
+        """``count`` conversations per arm, both arms identical: no real effect."""
+        for i in range(count):
+            ledger.record("treatment", "s", tokens, f"t{i}")
+            ledger.record("control", "s", tokens, f"c{i}")
+
+    def test_legacy_arms_alone_never_qualify(self):
+        assert SavingsLedger.from_dict(self._legacy_dict()).estimate_from_holdout() is None
+
+    def test_new_conversations_do_not_drag_legacy_totals_into_the_measurement(self):
+        """The reported regression, end to end.
+
+        Five labelled conversations an arm, showing no difference at all, used
+        to admit 2,500 unattributed legacy requests an arm and report
+        "measured -99.8% over 2,505 treatment requests".
+        """
+        ledger = SavingsLedger.from_dict(self._legacy_dict())
+        self._add_matched_conversations(ledger)
+
+        est = ledger.estimate_from_holdout()
+        assert est is not None, "the labelled conversations themselves do qualify"
+        assert est.kind == "measured"
+        # The labelled conversations are identical across arms, so the honest
+        # answer is zero -- not the -99.8% the legacy totals would produce.
+        assert est.pct == pytest.approx(0.0)
+        assert est.n_requests == MEASURED_MIN_CLUSTERS
+
+    def test_legacy_totals_are_preserved_for_the_estimated_tier(self):
+        """Quarantined from the measured number, not discarded."""
+        ledger = SavingsLedger.from_dict(self._legacy_dict())
+        self._add_matched_conversations(ledger)
+
+        arm = ledger.treatment["s"]
+        assert arm.n == 2_500 + MEASURED_MIN_CLUSTERS
+        assert arm.qualified is not None and arm.qualified.n == MEASURED_MIN_CLUSTERS
+
+        # And they still reach the estimated tier, which reads the totals.
+        for _ in range(40):
+            ledger.baseline.observe("s", 1_400.0)
+        estimated = ledger.estimate_from_baseline()
+        assert estimated.kind == "estimated"
+        assert estimated.n_requests == 2_500 + MEASURED_MIN_CLUSTERS
+
+    def test_unlabelled_traffic_cannot_join_an_already_qualified_stratum(self):
+        """The other direction: qualify first, then send unattributed traffic."""
+        ledger = SavingsLedger()
+        self._add_matched_conversations(ledger)
+        before = ledger.estimate_from_holdout()
+        assert before is not None
+
+        for _ in range(1_000):
+            ledger.record("treatment", "s", 99_999)
+
+        after = ledger.estimate_from_holdout()
+        assert after is not None
+        assert after.pct == pytest.approx(before.pct)
+        assert after.n_requests == before.n_requests
+        assert ledger.treatment["s"].n == MEASURED_MIN_CLUSTERS + 1_000, "totals still counted"
+
+    def test_the_split_survives_save_and_load(self, tmp_path):
+        """An upgraded ledger flushed and reloaded must not re-merge the arms."""
+        ledger = SavingsLedger.from_dict(self._legacy_dict())
+        self._add_matched_conversations(ledger)
+        path = tmp_path / "savings.json"
+        ledger.save(path)
+
+        reloaded = SavingsLedger.load(path)
+        est = reloaded.estimate_from_holdout()
+        assert est is not None
+        assert est.pct == pytest.approx(0.0)
+        assert est.n_requests == MEASURED_MIN_CLUSTERS
+        assert reloaded.treatment["s"].n == 2_500 + MEASURED_MIN_CLUSTERS
+
+    def test_a_legacy_ledger_on_disk_stays_unqualified_forever(self, tmp_path):
+        """Round-tripping legacy arms must not invent provenance for them."""
+        path = tmp_path / "savings.json"
+        path.write_text(json.dumps(self._legacy_dict()))
+
+        reloaded = SavingsLedger.load(path)
+        assert reloaded.treatment["s"].qualified is None
+        reloaded.save(path)
+        assert SavingsLedger.load(path).estimate_from_holdout() is None
+
+    def test_recorder_upgrade_path_reaches_the_threshold_cleanly(self, tmp_path):
+        """Same story through the live label channel rather than the ledger API."""
+        path = tmp_path / "savings.json"
+        path.write_text(json.dumps(self._legacy_dict()))
+        recorder = SavingsRecorder(path, flush_every=1)
+
+        for i in range(MEASURED_MIN_CLUSTERS):
+            for arm in ("treatment", "control"):
+                assert recorder.record_from_labels(
+                    [stratum_label(arm, "s"), conversation_label(f"{arm}{i}")], 500
+                )
+        # An old client on the same stratum, still sending no conversation.
+        assert recorder.record_from_labels([stratum_label("treatment", "s")], 99_999)
+
+        est = SavingsLedger.load(path).estimate_from_holdout()
+        assert est is not None
+        assert est.pct == pytest.approx(0.0)
+        assert est.n_requests == MEASURED_MIN_CLUSTERS
+
+    def test_merge_keeps_the_two_views_apart(self):
+        """``merge`` is how the offline baseline folds accumulators together."""
+        legacy = _Accum()
+        for _ in range(100):
+            legacy.add(1_000.0)
+        labelled = _Accum()
+        for i in range(3):
+            labelled.add(500.0, f"c{i}")
+
+        legacy.merge(labelled)
+        assert legacy.n == 103
+        assert legacy.qualified is not None
+        assert legacy.qualified.n == 3, "only the labelled observations carry over"
+        assert legacy.qualified.n_clusters == 3
 
 
